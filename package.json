{
  "name": "data-gateway",
  "productName": "Data Gateway",
  "version": "1.2.0",
  "description": "Transforma bancos de dados existentes (SQL Server, PostgreSQL, MySQL, MariaDB, Firebird e SQLite) em APIs REST seguras, configuradas visualmente.",
  "author": {
    "name": "Hendell Alves Cardoso",
    "email": "suporte@api2dev.com.br",
    "url": "https://api2dev.com.br"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config vite.config.mjs",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build --config vite.config.mjs",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build:renderer && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "node --test tests/gateway.test.js tests/queryBuilder.test.js tests/consultas.test.js tests/externos.test.js tests/firebird.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "node-firebird": "^2.18.2",
    "pg": "^8.13.1",
    "swagger-ui-dist": "^5.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.datagateway.desktop",
    "productName": "Data Gateway",
    "executableName": "Data Gateway",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/server/**/*",
      "src/database/**/*",
      "dist/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/swagger-ui-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Data Gateway",
      "uninstallDisplayName": "Data Gateway",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "DataGateway-Setup-${version}.exe"
    },
    "copyright": "© 2026 Hendell Alves Cardoso - API2Dev",
    "portable": {
      "artifactName": "DataGateway-Portable-${version}.exe"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hendellacardoso/api-gateway-desktop.git"
  },
  "homepage": "https://api2dev.com.br"
}
